---
import Layout from '../layouts/Layout.astro';
import Preview from '../components/Preview.astro';
import Modes from '../components/Modes.astro';
import { questions, steps } from '../content/site';
import { link, repository } from '../lib/urls';
---

<Layout
  title="TraderAI — платформа авторских стратегий в разработке"
  description="Интеллектуальная платформа для трейдеров и инвесторов: авторские стратегии, Video RAG, проверяемые решения и независимый контроль риска."
>
  <section class="hero-splash">
    <div class="hero-art" aria-hidden="true">
      <img
        src={link('images/signal-sculpture-1440.webp')}
        srcset={`${link('images/signal-sculpture-800.webp')} 800w, ${link('images/signal-sculpture-1440.webp')} 1440w`}
        sizes="(max-width: 800px) 100vw, 70vw"
        width="1440"
        height="960"
        alt=""
        fetchpriority="high"
      />
    </div>
    <div class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">
          <span></span> Интеллект. Методика. Контроль.
        </p>
        <h1>
          Знакомая
          <br />
          стратегия.
          <br />
          <em>
            Новый уровень
            <br />
            контроля.
          </em>
        </h1>
        <p class="hero-description">
          Создаём платформу, где инвесторы смогут выбирать авторские стратегии, а трейдеры —
          превращать свой подход в проверяемый продукт.
        </p>
        <div class="actions">
          <a class="button primary" href={link('demo/')}>
            Исследовать демо <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={link('how-it-works/')}>
            Как это работает <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="small hero-note">
          <span class="status-dot"></span> Платформа в разработке · доступно учебное демо
        </p>
      </div>
      <div class="hero-aside">
        <div class="signal-badge">
          <span class="signal-orbit" aria-hidden="true">
            ✳
          </span>
          <div>
            <span class="mono">ЧЕЛОВЕК + AI</span>
            <strong>
              Ваша методика.
              <br />
              Новые возможности.
            </strong>
          </div>
        </div>
        <span class="art-caption mono">ВИЗУАЛЬНЫЙ ОБРАЗ РЫНКА / НЕ КОТИРОВКИ</span>
      </div>
    </div>
    <div class="hero-bottom wrap">
      <span class="mono">TRADERAI / RESEARCH TO REALITY</span>
      <a href="#investors">
        От идеи к проверке <span aria-hidden="true">↓</span>
      </a>
      <span class="mono">01 — 06</span>
    </div>
  </section>
  <div class="principle-strip wrap">
    <div>
      <span class="mono">01 / ПОДХОД</span>
      <strong>Авторская стратегия</strong>
    </div>
    <span aria-hidden="true">↗</span>
    <div>
      <span class="mono">02 / ТЕХНОЛОГИЯ</span>
      <strong>ИИ + проверяемый код</strong>
    </div>
    <span aria-hidden="true">↗</span>
    <div>
      <span class="mono">03 / КОНТРОЛЬ</span>
      <strong>Объяснимые решения</strong>
    </div>
  </div>
  <section class="investor-section" id="investors">
    <div class="wrap section">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow">01 / ДЛЯ ИНВЕСТОРОВ</p>
          <h2>
            От идеи автора —<br />
            <em>к понятному процессу.</em>
          </h2>
        </div>
        <p>
          Вы знаете подход автора. Мы работаем над тем, чтобы связать его методику, брокерскую
          инфраструктуру и ваши ограничения в одной системе.
        </p>
      </div>
      <div class="investor-grid">
        <figure class="editorial-photo" data-reveal>
          <img
            src={link('images/research-desk-1440.webp')}
            srcset={`${link('images/research-desk-800.webp')} 800w, ${link('images/research-desk-1440.webp')} 1440w`}
            sizes="(max-width: 800px) 100vw, 50vw"
            width="1440"
            height="960"
            alt="Иллюстрация исследования: торговые сценарии в блокноте рядом с ноутбуком"
            loading="lazy"
          />
          <figcaption>
            <span class="mono">СНАЧАЛА — МЕТОДИКА</span>
            <strong>
              За каждой стратегией
              <br />
              стоит подход человека.
            </strong>
            <small>Иллюстрация, созданная с помощью ИИ</small>
          </figcaption>
        </figure>
        <div class="steps">
          {steps.map(([title, text], i) => (
            <article data-reveal>
              <span class="step-number">
                0{i + 1}
                <span aria-hidden="true">↗</span>
              </span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
      <p class="section-note">
        Сценарий будущей платформы. Подключение счетов и реальное исполнение пока недоступны.
      </p>
    </div>
  </section>
  <section class="section author-section" id="authors">
    <div class="wrap">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow">02 / ДЛЯ АВТОРОВ СТРАТЕГИЙ</p>
          <h2>
            Ваш способ торговать.
            <br />
            <em>Общие инструменты развития.</em>
          </h2>
        </div>
        <a class="text-link" href={link('for-authors/')}>
          Возможности для трейдеров ↗
        </a>
      </div>
      <Modes />
      <div class="shared-line">
        <span class="mono">ЕДИНЫЙ КОНТУР</span>
        <span>Анализ сделок</span>
        <b aria-hidden="true">+</b>
        <span>Формализация правил</span>
        <b aria-hidden="true">+</b>
        <span>Проверяемые подсказки</span>
      </div>
    </div>
  </section>
  <section class="section wrap research-section" id="technology" data-reveal>
    <div>
      <p class="eyebrow">03 / ИНЖЕНЕРНЫЙ ПОДХОД</p>
      <h2>
        ИИ понимает контекст.
        <br />
        Код проверяет условия.
        <br />
        <em>Человек задаёт границы.</em>
      </h2>
      <p class="lead compact">
        Создаём отдельную базу знаний каждой стратегии. ИИ-агенты помогают работать с методикой,
        Telegram-бот связывает план, наблюдение и разбор, а код отвечает за расчёты и риск.
      </p>
      <a class="text-link" href={link('technology/')}>
        Семь частей технологической платформы ↗
      </a>
    </div>
    <div class="research-list">
      <div class="knowledge-visual" aria-hidden="true">
        <div class="knowledge-source">
          <span>▶</span>
          <i></i>
          <i></i>
          <i></i>
          <small>VIDEO</small>
        </div>
        <div class="knowledge-trace">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="knowledge-core">
          AI<span>КОНТЕКСТ</span>
        </div>
        <div class="knowledge-trace">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="knowledge-proof">
          ✓<small>ИСТОЧНИК</small>
        </div>
      </div>
      <article>
        <span class="mono">01</span>
        <div>
          <h3>Своя стратегия — своя RAG-база</h3>
          <p>
            Видео, правила и разборы автора становятся контекстом для ИИ. Транскрибация, анализ
            кадров и поиск по смыслу связывают объяснение с источником и таймкодом.
          </p>
        </div>
      </article>
      <article>
        <span class="mono">02</span>
        <div>
          <h3>ИИ-агенты и управление через Telegram</h3>
          <p>
            Поиск знаний, разбор плана, объяснение событий и аналитика — отдельные роли. В боте
            предусматриваем вопросы по методике, работу с планом, уведомления и отчёты.
          </p>
        </div>
      </article>
      <article>
        <span class="mono">03</span>
        <div>
          <h3>Журнал, анализ и рекомендации</h3>
          <p>
            От сигнала и причины отказа до результата сделки с учётом издержек. На основе журнала ИИ
            предлагает гипотезы; каждое изменение проходит испытание, независимые проверки риска и
            рассмотрение человеком.
          </p>
        </div>
      </article>
    </div>
  </section>
  <section class="wrap demo-banner" data-reveal>
    <div>
      <p class="eyebrow">04 / ПРОЦЕСС В ДЕЙСТВИИ</p>
      <h2>
        Что произойдёт,
        <br />
        если проверка не пройдена?
      </h2>
      <p>
        Три источника решений. Один журнал. Посмотрите, как система объясняет разрешение, отказ и
        недостаток данных.
      </p>
      <a class="button primary" href={link('demo/')}>
        Открыть демонстрацию <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="demo-preview" data-reveal>
      <Preview />
    </div>
  </section>
  <section class="section wrap" id="stage">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">05 / СТАТУС ПРОЕКТА</p>
        <h2>Развиваем поэтапно.</h2>
      </div>
      <p>
        Исследовательские прототипы — основа работы. Публичная платформа и допуск к реальным счетам
        требуют следующих этапов.
      </p>
    </div>
    <div class="roadmap">
      <article class="current">
        <span class="outline-tag">Сейчас</span>
        <h3>Концепция и демонстрация</h3>
        <p>Публичный сайт, архитектура и учебные сценарии. Подготовка раннего доступа.</p>
      </article>
      <article>
        <span class="outline-tag">Следующий этап</span>
        <h3>Закрытая проверка</h3>
        <p>Согласование с авторами, проверка правил и виртуальные испытания.</p>
      </article>
      <article>
        <span class="outline-tag">В перспективе</span>
        <h3>Ограниченный пилот</h3>
        <p>После технической, брокерской и правовой подготовки. Без обещанной даты.</p>
      </article>
    </div>
  </section>
  <section class="section wrap faq-section">
    <div>
      <p class="eyebrow">06 / ВОПРОСЫ ПО СУЩЕСТВУ</p>
      <h2>
        До того,
        <br />
        как начать.
      </h2>
      <a class="text-link" href={link('risks/')}>
        Подробнее о рисках ↗
      </a>
    </div>
    <div class="faq">
      {questions.map(([q, a]) => (
        <details>
          <summary>
            {q}
            <span aria-hidden="true">＋</span>
          </summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
  <section class="wrap final-cta" data-reveal>
    <span class="cta-symbol" aria-hidden="true">
      ✳
    </span>
    <p class="eyebrow">TRADERAI / ОТ ИДЕИ К ПРОВЕРКЕ</p>
    <h2>
      Понимать стратегию.
      <br />
      <em>Доверять проверяемому процессу.</em>
    </h2>
    <div class="actions">
      <a class="button primary" href={link('early-access/')}>
        Статус раннего доступа ↗
      </a>
      <a class="text-link" href={repository}>
        Код демонстрации на GitHub ↗
      </a>
    </div>
  </section>
</Layout>
