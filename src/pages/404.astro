---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { link } from '../lib/urls';
---

<Layout
  title="Страница не найдена — TraderAI"
  description="Вернитесь к описанию платформы TraderAI."
  noindex
>
  <PageIntro
    eyebrow="404 / страница не найдена"
    title="Здесь пока нет страницы."
    text="Возможно, ссылка устарела или в адресе опечатка. Вернёмся к тому, что уже можно исследовать."
  >
    <div class="actions">
      <a class="button primary" href={link()}>
        На главную →
      </a>
      <a class="text-link" href={link('demo/')}>
        Открыть демо ↗
      </a>
    </div>
  </PageIntro>
</Layout>
