---
import Mark from '../components/Mark.astro';
import { link, repository } from '../lib/urls';
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/visual.css';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const preview = process.env.SITE_MODE === 'preview';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['Как это работает', 'how-it-works/'],
  ['Для трейдеров', 'for-authors/'],
  ['Технологии', 'technology/'],
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1218" />
    <meta name="robots" content={noindex || preview ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={link('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(link('social.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <script src="../scripts/motion.ts"></script>
    <a class="skip" href="#main">
      Перейти к содержимому
    </a>
    <header class="header">
      <div class="wrap header-inner">
        <a class="brand" href={link()} aria-label="TraderAI — главная">
          <Mark />
          <span>
            Trader<span class="brand-ai">AI</span>
          </span>
        </a>
        <nav aria-label="Основная навигация" class="desktop-nav">
          {nav.map(([label, path]) => (
            <a
              href={link(path)}
              aria-current={Astro.url.pathname.endsWith(`/${path}`) ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
        </nav>
        <a class="header-cta" href={link('demo/')}>
          Исследовать демо <span aria-hidden="true">↗</span>
        </a>
        <details class="mobile-menu">
          <summary aria-label="Открыть меню">
            Меню <span aria-hidden="true">＋</span>
          </summary>
          <nav aria-label="Мобильная навигация">
            {nav.map(([label, path]) => (
              <a href={link(path)}>{label}</a>
            ))}
            <a href={link('safety/')}>Контроль и риски</a>
            <a href={link('early-access/')}>Статус проекта</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-top">
        <div>
          <a class="brand" href={link()}>
            <Mark />
            <span>TraderAI</span>
          </a>
          <p>
            От понимания стратегии
            <br />к проверяемым решениям.
          </p>
        </div>
        <div class="footer-links">
          <a href={link('safety/')}>Контроль и риски</a>
          <a href={link('risks/')}>Инвестиционные риски</a>
          <a href={link('contacts/')}>О проекте и контакты</a>
        </div>
        <div class="footer-links">
          <a href={repository}>Публичный репозиторий ↗</a>
          <a href={link('early-access/')}>Статус раннего доступа</a>
          <a href={link('privacy/')}>Данные на этом сайте</a>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p>
          TraderAI находится в разработке. Реальная автоматическая торговля на сайте недоступна.
          Операции с финансовыми инструментами связаны с риском потери капитала. Исторические и
          тестовые результаты не гарантируют будущих результатов.
        </p>
        <div>
          <span>© {new Date().getUTCFullYear()} TraderAI</span>
          <span class="mono">PUBLIC SHOWCASE · v0.2</span>
        </div>
      </div>
    </footer>
  </body>
</html>
